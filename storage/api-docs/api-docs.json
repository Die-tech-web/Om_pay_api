{
    "openapi": "3.0.3",
    "info": {
        "title": "OM Pay API",
        "description": "API complète pour le système de paiement OM Pay",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api",
            "description": "Serveur local"
        },
        {
            "url": "https://om-pay-api-p17s.onrender.com/api",
            "description": "Serveur de production"
        }
    ],
    "paths": {
        "/register": {
            "post": {
                "summary": "Inscription d'un nouvel utilisateur",
                "description": "Inscription d'un nouvel utilisateur avec envoi automatique d'email de confirmation contenant les identifiants de connexion",
                "tags": [
                    "Authentification"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "nom",
                                    "prenom",
                                    "telephone",
                                    "email",
                                    "code_pin"
                                ],
                                "properties": {
                                    "nom": {
                                        "type": "string",
                                        "example": "Fatou"
                                    },
                                    "prenom": {
                                        "type": "string",
                                        "example": "Fall"
                                    },
                                    "telephone": {
                                        "type": "string",
                                        "example": "771234567"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "fatou.fall@gmail.com"
                                    },
                                    "code_pin": {
                                        "type": "string",
                                        "example": "1234"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Utilisateur créé avec succès",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Utilisateur créé avec succès"
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "user": {
                                                    "type": "object",
                                                    "properties": {
                                                        "id": {
                                                            "type": "string",
                                                            "example": "OE093939304004040040"
                                                        },
                                                        "nom": {
                                                            "type": "string",
                                                            "example": "Fatou"
                                                        },
                                                        "prenom": {
                                                            "type": "string",
                                                            "example": "Fall"
                                                        },
                                                        "telephone": {
                                                            "type": "string",
                                                            "example": "771234567"
                                                        },
                                                        "email": {
                                                            "type": "string",
                                                            "example": "fatou.fall@gmail.com"
                                                        },
                                                        "role": {
                                                            "type": "string",
                                                            "example": "client"
                                                        },
                                                        "created_at": {
                                                            "type": "string",
                                                            "format": "date-time"
                                                        },
                                                        "updated_at": {
                                                            "type": "string",
                                                            "format": "date-time"
                                                        }
                                                    }
                                                },
                                                "compte": {
                                                    "type": "object",
                                                    "properties": {
                                                        "id": {
                                                            "type": "string",
                                                            "example": "0192c8b0-8b4a-7c8b-9b4a-8b4a7c8b9b4a"
                                                        },
                                                        "id_client": {
                                                            "type": "string",
                                                            "example": "OE093939304004040040"
                                                        },
                                                        "numero_compte": {
                                                            "type": "string",
                                                            "example": "OM12345678"
                                                        },
                                                        "code_pin": {
                                                            "type": "string",
                                                            "example": "1234"
                                                        },
                                                        "type": {
                                                            "type": "string",
                                                            "example": "client"
                                                        },
                                                        "date_creation": {
                                                            "type": "string",
                                                            "format": "date",
                                                            "example": "2025-11-12"
                                                        },
                                                        "statut": {
                                                            "type": "string",
                                                            "example": "actif"
                                                        },
                                                        "code_qr": {
                                                            "type": "string",
                                                            "description": "Code QR en base64 pour le compte",
                                                            "example": "iVBORw0KGgoAAAANSUhEUgAAAMgAAADICAYAAACtWK6eAAAgAElEQVR4nOz9..."
                                                        },
                                                        "solde": {
                                                            "type": "number",
                                                            "format": "float",
                                                            "example": 50000
                                                        },
                                                        "metadata": {
                                                            "type": "object",
                                                            "example": {
                                                                "derniereModification": "2025-11-12T13:00:00Z",
                                                                "version": 1
                                                            }
                                                        },
                                                        "created_at": {
                                                            "type": "string",
                                                            "format": "date-time"
                                                        },
                                                        "updated_at": {
                                                            "type": "string",
                                                            "format": "date-time"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erreur de validation"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "summary": "Connexion d'un utilisateur",
                "tags": [
                    "Authentification"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "telephone",
                                    "code_pin"
                                ],
                                "properties": {
                                    "telephone": {
                                        "type": "string",
                                        "example": "771234567"
                                    },
                                    "code_pin": {
                                        "type": "string",
                                        "example": "1234"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Connexion réussie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Connexion réussie"
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "access_token": {
                                                    "type": "string",
                                                    "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..."
                                                },
                                                "refresh_token": {
                                                    "type": "string",
                                                    "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..."
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "example": "Bearer"
                                                },
                                                "expires_in": {
                                                    "type": "integer",
                                                    "example": 3600
                                                },
                                                "expires_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "example": "2025-11-10T09:47:17.442309Z"
                                                },
                                                "refresh_expires_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "example": "2025-12-10T08:47:17.442409Z"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Téléphone ou code PIN invalide"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
